# Quickstart-only settings. The signing key below is PUBLIC and exists only
# so the demo can mint tokens. Never reuse this file for a real deployment.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Qdrant here runs without auth on a private compose network; Core still
# requires a value.
QDRANT_API_KEY=quickstart-unused
TEI_DENSE_URL=http://tei-dense
TEI_SPARSE_URL=http://tei-sparse
TEI_RERANKER_URL=http://tei-reranker
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
SPARSE_MODEL=naver/efficient-splade-VI-BT-large-doc
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_MODEL=qwen2.5:0.5b
BRAIN_PORT=8100
VAULT_PATH=/tmp/musubi/vault
ARTIFACT_BLOB_PATH=/tmp/musubi/artifacts
LIFECYCLE_SQLITE_PATH=/tmp/musubi/lifecycle/work.sqlite
LOG_DIR=/tmp/musubi/logs
JWT_SIGNING_KEY=quickstart-demo-signing-key-public-do-not-deploy-32+bytes
OAUTH_AUTHORITY=https://auth.quickstart.local
MUSUBI_GRPC=false
MUSUBI_ALLOW_PLAINTEXT=true
