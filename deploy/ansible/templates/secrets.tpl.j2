{% set refs = musubi_op_refs | default({}) -%}
# Contains 1Password references only. Material values resolve at service start.
JWT_SIGNING_KEY={{ refs.jwt_signing_key | default('', true) or undef(hint='musubi_op_refs.jwt_signing_key is required') }}
QDRANT_API_KEY={{ refs.qdrant_api_key | default('', true) or undef(hint='musubi_op_refs.qdrant_api_key is required') }}
LIFECYCLE_LLM_API_KEY={{ refs.lifecycle_llm_api_key | default('', true) or undef(hint='musubi_op_refs.lifecycle_llm_api_key is required') }}
# Credentials stay out of URLs so HTTP client logs, exceptions, and request
# representations cannot disclose them.
TEI_DENSE_URL={{ refs.tei_dense_url | default('', true) or undef(hint='musubi_op_refs.tei_dense_url is required') }}
TEI_SPARSE_URL={{ refs.tei_sparse_url | default('', true) or undef(hint='musubi_op_refs.tei_sparse_url is required') }}
TEI_RERANKER_URL={{ refs.tei_reranker_url | default('', true) or undef(hint='musubi_op_refs.tei_reranker_url is required') }}
TEI_BASIC_AUTH_USERNAME={{ refs.tei_basic_auth_username | default('', true) or undef(hint='musubi_op_refs.tei_basic_auth_username is required') }}
TEI_BASIC_AUTH_PASSWORD={{ refs.tei_basic_auth_password | default('', true) or undef(hint='musubi_op_refs.tei_basic_auth_password is required') }}
