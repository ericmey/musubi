QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=<qdrant-api-key>

TEI_DENSE_URL=http://tei-dense
TEI_SPARSE_URL=http://tei-sparse
TEI_RERANKER_URL=http://tei-reranker
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=BAAI/bge-m3
SPARSE_MODEL=naver/splade-v3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Any Ollama model tag works. qwen3.5:9b is a 6.6 GB download; on a smaller
# GPU, qwen3.5:4b (3.4 GB) does the same jobs with less headroom.
LLM_MODEL=qwen3.5:9b
# Lifecycle LLM backend (ADR 0043). By default the sweeps use the Ollama
# endpoint above. To use an OpenAI-compatible endpoint (vLLM, LiteLLM, a
# hosted provider) instead, set the first three; the server refuses to start
# if the base URL or model is missing. The key is only needed if the endpoint
# asks for one.
#LIFECYCLE_LLM_API=openai
#LIFECYCLE_LLM_BASE_URL=https://llm.example.com/v1
#LIFECYCLE_LLM_MODEL=qwen3.5-9b
#LIFECYCLE_LLM_API_KEY=<api key>

BRAIN_PORT=8100
VAULT_PATH=/var/lib/musubi/vault
ARTIFACT_BLOB_PATH=/var/lib/musubi/artifact-blobs
LIFECYCLE_SQLITE_PATH=/var/lib/musubi/lifecycle/work.sqlite
LOG_DIR=/var/log/musubi

JWT_SIGNING_KEY=<jwt-signing-key>
OAUTH_AUTHORITY=https://auth.internal.example.com

MUSUBI_ALLOW_PLAINTEXT=false
