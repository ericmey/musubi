# Musubi Core — environment variables.
#
# Copy to `.env` at the repo root and fill in the empty values. Keep the
# resulting file private. Compose refuses empty keys or endpoint URLs. Core
# probes Qdrant and the dense TEI endpoint at startup; test all configured
# inference services with an authorized canary before relying on the stack.
#
# Canonical spec: docs/Musubi/08-deployment/compose-stack.md.
# Loader: src/musubi/settings.py. Accessor: src/musubi/config.get_settings().
#
# Never commit a filled-in copy of this file. `.env` and `.env.local`
# are already in .gitignore.

# --------------------------------------------------------------------------
# Qdrant
# --------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# --------------------------------------------------------------------------
# Inference endpoints
# --------------------------------------------------------------------------
# Set reachable endpoints. For the optional local-GPU override use
# http://tei-dense, http://tei-sparse, http://tei-reranker and
# http://ollama:11434 respectively.
TEI_DENSE_URL=
TEI_SPARSE_URL=
TEI_RERANKER_URL=
OLLAMA_URL=
# Set both or neither if your TEI endpoints use Basic authentication.
#TEI_BASIC_AUTH_USERNAME=
#TEI_BASIC_AUTH_PASSWORD=

EMBEDDING_MODEL=BAAI/bge-m3
SPARSE_MODEL=naver/splade-v3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=qwen3:4b
# Optional lifecycle LLM override; omit to use OLLAMA_URL and LLM_MODEL.
#LIFECYCLE_LLM_API=openai
#LIFECYCLE_LLM_BASE_URL=https://llm.example.com/v1
#LIFECYCLE_LLM_MODEL=example/model
#LIFECYCLE_LLM_API_KEY=

# --------------------------------------------------------------------------
# Core service
# --------------------------------------------------------------------------
MUSUBI_CORE_BIND=127.0.0.1
MUSUBI_CORE_PORT=8100
BRAIN_PORT=8100
VAULT_PATH=/var/lib/musubi/vault
ARTIFACT_BLOB_PATH=/var/lib/musubi/artifact-blobs
LIFECYCLE_SQLITE_PATH=/var/lib/musubi/lifecycle/work.sqlite
LOG_DIR=/var/log/musubi

# --------------------------------------------------------------------------
# Auth
# --------------------------------------------------------------------------
JWT_SIGNING_KEY=
OAUTH_AUTHORITY=https://oauth.deferred.invalid/

# --------------------------------------------------------------------------
# Feature flags
# --------------------------------------------------------------------------
MUSUBI_GRPC=false
MUSUBI_ALLOW_PLAINTEXT=true
# To run local GPU inference, select a TEI image for your GPU architecture
# and use -f deploy/docker/compose.local-gpu.yml with the root Compose file.
#MUSUBI_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:<GPU-compatible-tag>
#MUSUBI_TEI_DIGEST=<digest-without-sha256-prefix>
#MUSUBI_OLLAMA_IMAGE=ollama/ollama:<reviewed-version>
#MUSUBI_OLLAMA_DIGEST=<digest-without-sha256-prefix>
# Opt-in to the artifact-archival lifecycle sweep. When true, unreferenced
# artifacts older than 180 days are transitioned to state=archived (blob
# bytes preserved). Leave false on deploys that haven't decided archival
# policy yet — the default is a no-op.
MUSUBI_ARTIFACT_ARCHIVAL_ENABLED=false
